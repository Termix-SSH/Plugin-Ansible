{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [],
  "routes": {
    "DELETE /plugin-api/ansible/:hostId/file": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "GET /plugin-api/ansible/:hostId/file": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "edit"
      }
    },
    "PUT /plugin-api/ansible/:hostId/file": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "GET /plugin-api/ansible/:hostId/files": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "GET /plugin-api/ansible/:hostId/runs": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/ansible/:hostId/runs": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "DELETE /plugin-api/ansible/:hostId/runs/:runId": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true,
      "allowed": "any",
      "note": "Names a runId on the host, which the test host does not have; host access is still checked"
    },
    "GET /plugin-api/ansible/:hostId/runs/:runId": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "edit"
      },
      "allowed": "any",
      "note": "Names a runId on the host, which the test host does not have; host access is still checked"
    },
    "POST /plugin-api/ansible/:hostId/runs/:runId/cancel": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true,
      "allowed": "any",
      "note": "Names a runId on the host, which the test host does not have; host access is still checked"
    },
    "GET /plugin-api/ansible/:hostId/runs/:runId/facts": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "edit"
      },
      "allowed": "any",
      "note": "Names a runId on the host, which the test host does not have; host access is still checked"
    },
    "GET /plugin-api/ansible/:hostId/status": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "GET /plugin-api/ansible/:hostId/targets": {
      "access": "user",
      "permission": "ansible.use",
      "resource": {
        "kind": "host",
        "min": "edit"
      }
    },
    "GET /plugin-api/ansible/summary": {
      "access": "user",
      "permission": "ansible.use"
    }
  }
}
